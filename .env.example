# Server port
PORT=3000

# Private Castle Gatekeeper Passcode (Default: libby)
CASTLE_PASSWORD=libby

# Gemini API Key (Server-Side)
GEMINI_API_KEY=

# Supabase (Project Settings -> API)
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Use either Secret Key (recommended for server) or Publishable Key
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
